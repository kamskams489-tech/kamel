rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny everything unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Standalone Entity Validators (Anti-Update-Gap) ---
    function isValidUserSettings(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.soundEnabled is bool &&
             data.vibrateEnabled is bool &&
             data.activeDhikrId is string && data.activeDhikrId.size() >= 1 && data.activeDhikrId.size() <= 64 &&
             data.activeDhikrId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.targetCount is int && data.targetCount >= 0 && data.targetCount <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomDhikr(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.target is int && data.target >= 0 && data.target <= 100000 &&
             data.colorHex is string && data.colorHex.size() == 7 &&
             data.colorHex.matches('^#[0-9a-fA-F]{6}$') &&
             data.countsAsIstighfar is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
             data.todayDate is string && data.todayDate.size() == 10 &&
             data.todayDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.todayTotal is int && data.todayTotal >= 0 && data.todayTotal <= 10000000 &&
             data.todayIstighfar is int && data.todayIstighfar >= 0 && data.todayIstighfar <= 10000000 &&
             data.allTimeTotal is int && data.allTimeTotal >= 0 && data.allTimeTotal <= 100000000 &&
             data.allTimeIstighfar is int && data.allTimeIstighfar >= 0 && data.allTimeIstighfar <= 100000000 &&
             data.dhikrTotals is map && data.dhikrTotals.size() <= 40 &&
             data.dhikrToday is map && data.dhikrToday.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Collection 1: Private User Settings (/users/{userId}) ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'soundEnabled', 'vibrateEnabled', 'activeDhikrId', 'targetCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'soundEnabled', 'vibrateEnabled', 'activeDhikrId', 'targetCount', 'createdAt', 'updatedAt']) &&
                       isValidUserSettings(incoming());

      allow update: if isValidUserSettings(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action: Update preferences or display name
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'soundEnabled', 'vibrateEnabled', 'activeDhikrId', 'targetCount', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- Collection 2: Owner-only Custom Adhkar (/users/{userId}/custom_adhkar/{dhikrId}) ---
      match /custom_adhkar/{dhikrId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(dhikrId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(dhikrId) &&
                         incoming().keys().hasAll(['userId', 'title', 'target', 'colorHex', 'countsAsIstighfar', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'target', 'colorHex', 'countsAsIstighfar', 'createdAt', 'updatedAt']) &&
                         isValidCustomDhikr(incoming());

        allow update: if isValidCustomDhikr(incoming()) &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(dhikrId) &&
                         existing().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Edit custom dhikr
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'target', 'colorHex', 'countsAsIstighfar', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(dhikrId);
      }
    }

    // --- Collection 3: Public Competition & Global Community Stats (/leaderboard/{userId}) ---
    // Contains zero PII. Client list queries MUST include .whereEqualTo("visibility", "public").
    match /leaderboard/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || (resource != null && existing().visibility == 'public'));
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'visibility', 'todayDate', 'todayTotal', 'todayIstighfar', 'allTimeTotal', 'allTimeIstighfar', 'dhikrTotals', 'dhikrToday', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'visibility', 'todayDate', 'todayTotal', 'todayIstighfar', 'allTimeTotal', 'allTimeIstighfar', 'dhikrTotals', 'dhikrToday', 'createdAt', 'updatedAt']) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isValidLeaderboardEntry(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action: Sync tasbih counters or update public display name
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'visibility', 'todayDate', 'todayTotal', 'todayIstighfar', 'allTimeTotal', 'allTimeIstighfar', 'dhikrTotals', 'dhikrToday', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
